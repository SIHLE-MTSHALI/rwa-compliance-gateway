# Normalize line endings in the repository, and keep them normalized in the
# working tree.
#
# This matters more than usual here: `forge fmt --check` is a required CI gate,
# and forge's formatter only emits LF. A Windows checkout with CRLF would fail
# that gate on files nobody touched. `* text=auto eol=lf` makes git check out LF
# everywhere regardless of the contributor's OS autocrlf setting.
* text=auto eol=lf

# Solidity, TypeScript, and config: always LF, always text.
*.sol   text eol=lf
*.ts    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf

# Never rewrite these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.mp4   binary
*.zip   binary
*.gz    binary
*.keystore binary